# ─── Base de datos ───────────────────────────────────────────────────────────
# En local con docker-compose el host es "db"; fuera de Docker, "localhost".
DATABASE_URL=postgresql+asyncpg://alertaboe:alertaboe@localhost:5432/alertaboe

# ─── APIs del BOE (datos abiertos) ───────────────────────────────────────────
BOE_API_BASE=https://boe.es/datosabiertos/api
BOE_REQUEST_TIMEOUT=30
BOE_MAX_RETRIES=4

# ─── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
# Proveedor principal para volumen (resúmenes, clasificación, guiones).
LLM_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Backup / razonamiento: OpenAI.
LLM_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alternativa opcional (si prefieres OpenRouter como backup, pon
# LLM_FALLBACK_PROVIDER=openrouter y rellena estas dos).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024

# ─── API pública ─────────────────────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
