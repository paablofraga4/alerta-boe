FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY boe ./boe
COPY apps ./apps
COPY alembic ./alembic
COPY alembic.ini ./
COPY infra/start.sh ./start.sh

RUN pip install --upgrade pip && pip install . && chmod +x ./start.sh

EXPOSE 8000
# Aplica migraciones y arranca uvicorn en $PORT (lo fija Render).
CMD ["sh", "./start.sh"]
