FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY boe ./boe
COPY workers ./workers
COPY alembic ./alembic
COPY alembic.ini ./

# El worker calcula embeddings → incluye el extra correspondiente.
RUN pip install --upgrade pip && pip install ".[worker,embeddings]"

CMD ["python", "-m", "workers.scheduler"]
